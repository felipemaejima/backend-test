# Copie para .env e ajuste se necessário. O compose já tem defaults para todos.
DB_USER=restock
DB_PASSWORD=restock
DB_NAME=restock
DB_EXTERNAL_PORT=5432
APP_EXTERNAL_PORT=8080

# debug | info | warn | error
LOG_LEVEL=info
# json | text  (text é mais legível durante o desenvolvimento)
LOG_FORMAT=json
# Vazio = apenas stdout, que é o recomendado.
# Para espelhar em arquivo no host: LOG_FILE=/app/logs/api.log
LOG_FILE=
